# Application Role: 'api' or 'worker'
APP_ROLE=api
PORT=8080

# Database Configuration
DATABASE_URL=jdbc:postgresql://postgres:5432/events_db
DATABASE_USERNAME=event_user
DATABASE_PASSWORD=event_pass

# Redis Configuration (Used from Batch 7 onwards for rate limiting)
REDIS_URL=redis://redis:6379

# Security
API_KEY=dev-api-key-32chars-secret-token-key

# Worker Configuration
WORKER_ID=worker-1
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_SECONDS=30
WORKER_CONCURRENCY=8

# Delivery Defaults
DELIVERY_BASE_BACKOFF_SECONDS=10
DELIVERY_MAX_BACKOFF_SECONDS=3600
DELIVERY_MAX_ATTEMPTS=8
DELIVERY_HTTP_TIMEOUT_MS=5000
